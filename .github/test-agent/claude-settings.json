{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(backend/tests/**)",
      "Edit(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Edit(.agent/report.json)",
      "Bash(python -m pytest *)",
      "Bash(npx vitest run *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
